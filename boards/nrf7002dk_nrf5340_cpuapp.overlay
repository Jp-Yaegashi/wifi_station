

/ {
	/* Force UART console for debug output */
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
	};
	
	/* Trace (TPIU) を止めて TRACEDATA/TRACECLK を解放 */



	/* nRF70 TX power configuration for WiFi */
	nrf70_tx_power_ceiling: nrf70_tx_power_ceiling_node {
		status = "okay";
		compatible = "nordic,nrf700x-tx-power-ceiling";
		max-pwr-2g-dsss = <21>;
		max-pwr-2g-mcs0 = <21>;
		max-pwr-2g-mcs7 = <21>;
		max-pwr-5g-low-mcs0 = <21>;
		max-pwr-5g-low-mcs7 = <21>;
		max-pwr-5g-mid-mcs0 = <21>;
		max-pwr-5g-mid-mcs7 = <21>;
		max-pwr-5g-high-mcs0 = <21>;
		max-pwr-5g-high-mcs7 = <21>;
	};
};
/ {
    wifi_ctrl: gpio-leds {
        compatible = "gpio-leds";

        wifi_buck_en: wifi_buck_en {
            gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
            label = "WIFI_BUCK_EN";
        };

        wifi_en: wifi_en {
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
            label = "WIFI_EN_IOVDD";
        };
    };
};


/ {
    user_gpio: user-gpio {
        compatible = "gpio-leds";

        coex_status0: coex_status0 {
            gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
            label = "BT_COEX_STATUS0";
        };
		
        coex_req: coex_req {
            gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
            label = "BT_COEX_REQ";
        };

        coex_grant: coex_grant {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
            label = "BT_COEX_GRANT";
        };

        sw_ctrl0: sw_ctrl0 {
            gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
            label = "SW_CTRL0";
        };

        sw_ctrl1: sw_ctrl1 {
            gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
            label = "SW_CTRL1";
        };

		
		led_a: led_a {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};

		led_b: led_b {
			gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
			label = "WiFi LED";
		};
		exp_spi_reset: exp_spi_reset {
			gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
			label = "EXP SPI RESET";
		};
		slot_uart_enable: slot_uart_enable {
			gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
			label = "SLOT UART ENABLE";
		};
		unit_spi_reset: unit_spi_reset {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "UNIT SPI RESET";
		};


    };
};


/* WM02C COEX configuration - Override nRF7002DK default with Mira Station pins */

&pinctrl {
	/* 自分で使うGPIO用の定義 */

	qspi_default: qspi_default {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 17)>,
				<NRF_PSEL(QSPI_IO0, 0, 13)>,
				<NRF_PSEL(QSPI_IO1, 0, 14)>,
				<NRF_PSEL(QSPI_IO2, 0, 15)>,
				<NRF_PSEL(QSPI_IO3, 0, 16)>,
				<NRF_PSEL(QSPI_CSN, 0, 18)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	qspi_sleep: qspi_sleep {
		group1 {
			psels = <NRF_PSEL(QSPI_SCK, 0, 17)>,
				<NRF_PSEL(QSPI_IO0, 0, 13)>,
				<NRF_PSEL(QSPI_IO1, 0, 14)>,
				<NRF_PSEL(QSPI_IO2, 0, 15)>,
				<NRF_PSEL(QSPI_IO3, 0, 16)>;
			low-power-enable;
		};
		group2 {
			psels = <NRF_PSEL(QSPI_CSN, 0, 18)>;
			low-power-enable;
			bias-pull-up;
		};
	};

	spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 23)>,
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;
            low-power-enable;
        };
    };
	
};

&nrf70 {
    status = "okay";
    //bucken-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
    //iovdd-ctrl-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
    host-irq-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>; // まずは元に戻す 
	qspi-frequency = <8000000>;
	
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";	
};

&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";

	cs-gpios =
        <&gpio0 21 GPIO_ACTIVE_LOW>, /* CS0: MCP23S17 */
        <&gpio0 25 GPIO_ACTIVE_LOW>; /* CS1: MCP23S08 */



    /* MCP23S17 : 16bit GPIO */
    mcp23s17: gpio@0 {
        compatible = "microchip,mcp23s17";
        reg = <0>;                  /* cs-gpios の0番 */
        spi-max-frequency = <5000000>;
        status = "okay";

        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
    };

    /* MCP23S08 : 8bit GPIO */
    mcp23s08: gpio@1 {
        compatible = "microchip,mcp23s08";
        reg = <1>;                  /* cs-gpios の1番 */
        spi-max-frequency = <5000000>;
        status = "okay";

        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <8>;
    
    };
};

/ {
    mcp_pins: mcp_pins {
        compatible = "gpio-leds";

        gp0: gp0 { gpios = <&mcp23s08 0 GPIO_ACTIVE_HIGH>; label = "MCP_GP0"; };
        gp1: gp1 { gpios = <&mcp23s08 1 GPIO_ACTIVE_HIGH>; label = "MCP_GP1"; };
        gp2: gp2 { gpios = <&mcp23s08 2 GPIO_ACTIVE_HIGH>; label = "MCP_GP2"; };       
    };
};


/* Mira Station UART0 configuration - Custom pins P0.24/P0.26 */
&pinctrl {
	uart0_mira_default: uart0_mira_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 24)>,
				<NRF_PSEL(UART_RX, 0, 26)>;
		};
	};

	uart0_mira_sleep: uart0_mira_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 24)>,
				<NRF_PSEL(UART_RX, 0, 26)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	/* Use Mira Station specific pinctrl */
	pinctrl-0 = <&uart0_mira_default>;
	pinctrl-1 = <&uart0_mira_sleep>;
	pinctrl-names = "default", "sleep";
};

/*  Station UART1 configuration - Custom pins P1.06/P1.08 */
&pinctrl {
	uart1_slot_default: uart1_slot_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
		};
	};

	uart1_slot_sleep: uart1_slot_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 6)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <230400>;
	/* Use Mira Station specific pinctrl */
	pinctrl-0 = <&uart1_slot_default>;
	pinctrl-1 = <&uart1_slot_sleep>;
	pinctrl-names = "default", "sleep";
};



&gpio0 {
    status = "okay";
};
